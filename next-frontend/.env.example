# Backend API URL (accessible by Next.js server runtime inside Docker container)
API_URL=http://host.docker.internal:3000

# Public API URL (accessible by browser for direct tus resumable uploads)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Next.js Port
PORT=3000

# Iron Session encryption key (must be at least 32 characters)
SESSION_PASSWORD=replace-with-at-least-32-chars-secret-key-for-session

# Cookie Secure flag (set to true in production behind HTTPS)
COOKIE_SECURE=false
